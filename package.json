{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "sunlint --all --input=resources && composer run lint",
    "lint:changed": "sunlint --all --changed-files",
    "lint:security": "sunlint --security --input=resources",
    "prepare": "husky"
  },
  "devDependencies": {
    "@sun-asterisk/sunlint": "^1.3.56",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^2.0.0",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7"
  },
  "dependencies": {
    "alpinejs": "^3.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "lint-staged": {
    "resources/**/*.{js,jsx,ts,tsx,css,scss}": [
      "sunlint --fix"
    ],
    "**/*.php": [
      "vendor/bin/pint"
    ]
  }
}
